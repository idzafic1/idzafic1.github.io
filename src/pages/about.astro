---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, isConfigured } from '../config/site';
---
<BaseLayout title="About" description="About Ismail Džafić, holding a BSc in Computer Science and first-year master's student focused on QA, API testing, and security-minded engineering.">
  <div class="container"><header class="page-header"><p class="eyebrow">Profile</p><h1>About</h1><p>A short account of my studies, language background, and current work.</p></header>
    <section class="section" style="padding-top:0"><div class="prose"><h2>Background</h2><p>I hold a BSc in Computer Science from the Faculty of Electrical Engineering, University of Sarajevo, and am currently a first-year master's student. My interests sit where software quality, API testing, performance, and practical security meet.</p><p>My relevant coursework includes data structures, compiler design, system-level programming, network programming, and memory management.</p></div></section>
    <section class="section"><div class="section-heading"><p class="eyebrow">Communication</p><h2>Languages</h2></div><div class="skills-grid"><div class="skill-group"><h3>Bosnian</h3><p class="muted">Native</p></div><div class="skill-group"><h3>English</h3><p class="muted">British Council EnglishScore</p></div><div class="skill-group"><h3>German</h3><p class="muted">DSD II</p></div></div></section>
    <section class="section"><div class="skills-grid"><div class="skill-group"><p class="eyebrow">Currently</p><h3>Thesis and projects</h3><p class="muted">BSc thesis project on a PQC Secure File Vault, SmartLib in progress, and Erasmus+ exchange in 2026/27.</p></div></div></section>
    <section class="section"><div class="callout"><p class="eyebrow">Contact</p><h2>Connect</h2><div class="button-row"><a class="btn btn-primary" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>{isConfigured(site.email) && <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email</a>}{isConfigured(site.linkedin) && <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}</div></div></section>
  </div>
</BaseLayout>
