---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
---
<BaseLayout title="Writeups" description="Security writeups and learning notes by Ismail Džafić. Passwords and flags are intentionally omitted.">
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">Security notes</p>
      <h1>Writeups</h1>
      <p>Selected notes from hands-on security learning. The main collection lives on an external site.</p>
    </header>
    <section class="callout">
      <h2>Bandit writeups</h2>
      <p class="muted">Explore the full OverTheWire Bandit collection with Markdown and terminal commands. Passwords and flags are intentionally omitted.</p>
      <div class="button-row">
        <a class="btn btn-primary" href={site.bandit.site} target="_blank" rel="noopener noreferrer">Visit external site ↗</a>
        <a class="btn btn-secondary" href={site.bandit.repo} target="_blank" rel="noopener noreferrer">Repository ↗</a>
      </div>
    </section>
    <p class="notice">More writeups coming soon.</p>
  </div>
</BaseLayout>
